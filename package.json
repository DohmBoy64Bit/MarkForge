{
  "name": "markforge",
  "version": "0.0.0",
  "private": true,
  "description": "Professional local-first Markdown editor and standalone viewer for Windows and Linux.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "audit:marktext": "python scripts/audit_marktext.py",
    "docs:check": "node -e \"console.log('MarkForge docs scaffold ready')\"",
    "dev:editor": "pnpm --filter @markforge/editor dev",
    "build:editor": "pnpm --filter @markforge/editor build",
    "tauri:dev": "pnpm --filter @markforge/editor tauri dev",
    "tauri:build": "pnpm --filter @markforge/editor tauri build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
