{
  "name": "markforge",
  "version": "0.0.0",
  "private": true,
  "description": "Professional local-first Markdown editor and standalone viewer for Windows and Linux.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "audit:marktext": "python scripts/audit_marktext.py",
    "docs:check": "node scripts/docs-check.mjs",
    "dev:editor": "pnpm --filter @markforge/editor dev",
    "build:editor": "pnpm --filter @markforge/editor build",
    "dev:viewer": "pnpm --filter @markforge/viewer dev",
    "build:viewer": "pnpm --filter @markforge/viewer build",
    "tauri:dev": "pnpm --filter @markforge/editor tauri dev",
    "tauri:build": "pnpm --filter @markforge/editor tauri build",
    "tauri:viewer:dev": "pnpm --filter @markforge/viewer tauri dev",
    "tauri:viewer:build": "pnpm --filter @markforge/viewer tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cargo:test": "node scripts/cargo-test.mjs",
    "test:tauri:smoke": "node scripts/tauri-smoke.mjs",
    "test:tauri:smoke:editor": "node scripts/tauri-smoke.mjs editor",
    "test:tauri:smoke:viewer": "node scripts/tauri-smoke.mjs viewer",
    "test:e2e:editor": "pnpm build:editor && pnpm build:viewer && node scripts/e2e-editor-ui.mjs",
    "test:e2e:viewer": "pnpm build:viewer && node scripts/e2e-viewer-ui.mjs",
    "test:e2e:ui": "pnpm test:e2e:editor",
    "browser:install": "playwright install chromium",
    "bundle:check": "node scripts/bundle-check.mjs",
    "packaging:check": "node scripts/packaging-check.mjs",
    "linux:smoke": "bash scripts/linux-smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@wdio/cli": "^9.29.0",
    "@wdio/local-runner": "^9.29.0",
    "@wdio/mocha-framework": "^9.29.0",
    "@wdio/spec-reporter": "^9.29.0",
    "edgedriver": "^6.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "vitest": "^4.1.9"
  }
}
