{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkForge",
  "version": "0.0.0",
  "identifier": "com.markforge.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkForge",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "txt"],
        "name": "MarkForge Markdown Document",
        "description": "Markdown and text documents",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
