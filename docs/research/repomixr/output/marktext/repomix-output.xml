<script setup lang="ts">
import { ref, reactive, watch, onMounted, onBeforeUnmount, nextTick, markRaw } from 'vue'
import log from 'electron-log'
import {
  Muya,
  CodeBlockLanguageSelector,
  EmojiSelector,
  FootnoteTool,
